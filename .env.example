# Copy this file to `.env` and fill in your own values.
# `.env` is listed in .gitignore, so it never gets uploaded to GitHub.
# Never paste these values into a chat, issue, or commit.

# --- Telegram (Phase 1) ---
# Get a token from @BotFather in Telegram (/newbot, or /revoke to replace a leaked one).
TELEGRAM_BOT_TOKEN=
# Run `python -m signalbot.chat_id` after messaging your bot to find this.
TELEGRAM_CHAT_ID=

# --- Alpaca (Phase 1) --- https://alpaca.markets  (use PAPER trading keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Finnhub (Phase 1) --- https://finnhub.io  (free tier)
FINNHUB_API_KEY=

# --- Later phases ---
# SEC EDGAR asks for a name + email in the request header (no key needed).
# SEC_USER_AGENT=Your Name you@example.com
# Phase 6, for AI news summaries:
# ANTHROPIC_API_KEY=
